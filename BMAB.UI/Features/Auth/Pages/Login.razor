@using BMAB.UI.Shared.Security
@page "/login"
@layout EmptyLayout
@inherits LoginBase

<PageTitle>BMAB - Login</PageTitle>

<div class="login-page">

    <div class="brand-panel">
        <div class="brand-panel-inner">
            <span class="brand-mark">BMAB</span>
            <p class="brand-tagline">Sign in to pick up where you left off.</p>
        </div>
    </div>

    <div class="form-panel">
        <div class="form-shell">

            <EditForm Model="@request" OnValidSubmit="SignIn" class="login-form">
                <DataAnnotationsValidator />

                <h1 class="form-title">Log in</h1>

                <MudTextField @bind-Value="request.UserName"
                              Label="Username"
                              Required="true"
                              Variant="Variant.Outlined"
                              Class="login-field"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Person"
                              onkeyup="@HandleKeyUp" />

                <div class="password-field-wrap">
                    <MudTextField @bind-Value="request.Password"
                                  Label="Password"
                                  InputType="@PasswordInput"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Class="login-field password-input"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Lock"
                                  onkeyup="@HandleKeyUp" />

                    <MudIconButton Icon="@PasswordIcon"
                                   Size="Size.Small"
                                   Class="password-toggle-btn"
                                   OnClick="ToggleShowPassword"
                                   aria-label="@(showPassword ? "Hide password" : "Show password")" />
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="form-error" role="alert">@error</p>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="IsLoading"
                           OnClick="SignIn"
                           Class="login-submit">
                    @if (IsLoading)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        <span>Logging in...</span>
                    }
                    else
                    {
                        <span>Log in</span>
                    }
                </MudButton>

                <p class="login-signup">
                    New to BMAB?
                    <MudLink href="/signup" Class="login-signup-link" Underline="Underline.Hover">Sign up</MudLink>
                </p>

            </EditForm>

        </div>
    </div>

</div>
